nks":[]},"va":{"text":"","wikitext":"","links":[]}},"infoboxes":[{"name":"infobox character","parameters":[{"name":"image","value_wikitext":"File:S2E27_Unnamed_Suit_026.png","value_text":"File:S2E27_Unnamed_Suit_026.png","links":[]},{"name":"aliases","value_wikitext":"","value_text":"","links":[]},{"name":"relations","value_wikitext":"","value_text":"","links":[]},{"name":"base","value_wikitext":"[[Vienna, Austria]]<br>[[Prague, Czech Republic]]","value_text":"Vienna, Austria\nPrague, Czech Republic","links":[{"target_title":"Vienna, Austria","label":"Vienna, Austria","target_id":"huntik:page:8234","target_url":"https://huntik.fandom.com/wiki/Vienna%2C_Austria","status":"resolved","href":"#/categories?name=Vienna%2C%20Austria"},{"target_title":"Prague, Czech Republic","label":"Prague, Czech Republic","target_id":"huntik:page:8072","target_url":"https://huntik.fandom.com/wiki/Prague%2C_Czech_Republic","status":"resolved","href":"#/categories?name=Prague%2C%20Czech%20Republic"}]},{"name":"group","value_wikitext":"[[The Organization]] {{Icon|ORG}}<br> [[Suits]]","value_text":"The Organization\nSuits","links":[{"target_title":"The Organization","label":"The Organization","target_id":"huntik:page:1990","target_url":"https://huntik.fandom.com/wiki/The_Organization","status":"resolved","href":"#/entry/huntik%3Apage%3A1990"},{"target_title":"Suits","label":"Suits","target_id":"huntik:page:2050","target_url":"https://huntik.fandom.com/wiki/Suits","status":"resolved","href":"#/entry/huntik%3Apage%3A2050"}]},{"name":"first","value_wikitext":"\"[[Home Turf]]\"","value_text":"\"Home Turf\"","links":[{"target_title":"Home Turf","label":"Home Turf","target_id":"huntik:page:3228","target_url":"https://huntik.fandom.com/wiki/Home_Turf","status":"resolved","href":"#/entry/huntik%3Apage%3A3228"}]},{"name":"last","value_wikitext":"","value_text":"","links":[]},{"name":"gender","value_wikitext":"Male","value_text":"Male","links":[]},{"name":"hair","value_wikitext":"Brown","value_text":"Brown","links":[]},{"name":"eyes","value_wikitext":"","value_text":"","links":[]},{"name":"va","value_wikitext":"","value_text":"","links":[]}],"start":0,"end":338}],"sections":[{"heading":"History","level":2,"wikitext":"This Suit was sent by [[Klaus]], under the instructions of [[Rassimov]], to go after [[Dante Vale]] in [[County Kerry, Ireland]]. His team of Suits ambushed [[Scarlet Byrne]] and Dante's team in the [[New Grange Passage Tomb]] but were eventually defeated. {{source|Home Turf}}\n\nThis Suit later was sent to [[Valley of the Kings, Egypt]], where he asked Klaus about the plan to deal with Dante's team. He and [[unnamed Suit 028|unnamed Suits 028]], [[unnamed Suit 030|030]], and [[unnamed Suit 033|033]] responded to an explosion set off by Dante and went to investigate the explosives shed. Afterwards, he accompanied Klaus and [[unnamed Suit 027]] to the tomb. Upon catching up to Dante's team at a pool, he attacked with a [[Raypulse]] and later invoked [[Enforcer]]. When Dante threw the [[Sceptre of Nefertiti]] into the pool, he and [[unnamed Suit 027]] were sent in to retrieve it. {{source|The Sceptre Deception}}","text":"This Suit was sent by Klaus, under the instructions of Rassimov, to go after Dante Vale in County Kerry, Ireland. His team of Suits ambushed Scarlet Byrne and Dante's team in the New Grange Passage Tomb but were eventually defeated. [Home Turf]\n\nThis Suit later was sent to Valley of the Kings, Egypt, where he asked Klaus about the plan to deal with Dante's team. He and unnamed Suits 028, 030, and 033 responded to an explosion set off by Dante and went to investigate the explosives shed. Afterwards, he accompanied Klaus and unnamed Suit 027 to the tomb. Upon catching up to Dante's team at a pool, he attacked with a Raypulse and later invoked Enforcer. When Dante threw the Sceptre of Nefertiti into the pool, he and unnamed Suit 027 were sent in to retrieve it. [The Sceptre Deception]"},{"heading":"Abilities","level":2,"wikitext":"Like most Suits, he was issued with the standard Organization [[Titans]].\n\n{{col-begin}}\n{{col-2}}","text":"Like most Suits, he was issued with the standard Organization Titans."},{"heading":"Spells Utilized","level":3,"wikitext":"* [[Augerfrost]]\n* [[Thundercut]] {{source|Home Turf}}\n\n{{col-2}}","text":"• Augerfrost\n• Thundercut [Home Turf]"},{"heading":"Bonded Titans","level":3,"wikitext":"* [[Bonelasher]]\n* [[Enforcer]]\n\n{{col-end}}\n[[Category:Seekers]]\n[[Category:Organization members]]\n[[Category:Suits]]","text":"• Bonelasher\n• Enforcer"}],"full_text":"Unnamed Suit 026 is a Suit within the Organization. He operates from Vienna, Austria, under Klaus.\n\nHistory\n\nThis Suit was sent by Klaus, under the instructions of Rassimov, to go after Dante Vale in County Kerry, Ireland. His team of Suits ambushed Scarlet Byrne and Dante's team in the New Grange Passage Tomb but were eventually defeated. [Home Turf]\n\nThis Suit later was sent to Valley of the Kings, Egypt, where he asked Klaus about the plan to deal with Dante's team. He and unnamed Suits 028, 030, and 033 responded to an explosion set off by Dante and went to investigate the explosives shed. Afterwards, he accompanied Klaus and unnamed Suit 027 to the tomb. Upon catching up to Dante's team at a pool, he attacked with a Raypulse and later invoked Enforcer. When Dante threw the Sceptre of Nefertiti into the pool, he and unnamed Suit 027 were sent in to retrieve it. [The Sceptre Deception]\n\nAbilities\n\nLike most Suits, he was issued with the standard Organization Titans.\n\nSpells Utilized\n\n• Augerfrost\n• Thundercut [Home Turf]\n\nBonded Titans\n\n• Bonelasher\n• Enforcer","raw_wikitext":"{{infobox character\n| image     = File:S2E27_Unnamed_Suit_026.png\n| aliases   = \n| relations = \n| base      = [[Vienna, Austria]]<br>[[Prague, Czech Republic]]\n| group     = [[The Organization]] {{Icon|ORG}}<br> [[Suits]]\n| first     = \"[[Home Turf]]\"\n| last      = \n| gender    = Male\n| hair      = Brown\n| eyes      = \n| va        = \n}}\n'''Unnamed Suit 026''' is a [[Suit]] within [[the Organization]]. He operates from  [[Vienna, Austria]], under [[Klaus]].\n\n== History ==\nThis Suit was sent by [[Klaus]], under the instructions of [[Rassimov]], to go after [[Dante Vale]] in [[County Kerry, Ireland]]. His team of Suits ambushed [[Scarlet Byrne]] and Dante's team in the [[New Grange Passage Tomb]] but were eventually defeated. {{source|Home Turf}}\n\nThis Suit later was sent to [[Valley of the Kings, Egypt]], where he asked Klaus about the plan to deal with Dante's team. He and [[unnamed Suit 028|unnamed Suits 028]], [[unnamed Suit 030|030]], and [[unnamed Suit 033|033]] responded to an explosion set off by Dante and went to investigate the explosives shed. Afterwards, he accompanied Klaus and [[unnamed Suit 027]] to the tomb. Upon catching up to Dante's team at a pool, he attacked with a [[Raypulse]] and later invoked [[Enforcer]]. When Dante threw the [[Sceptre of Nefertiti]] into the pool, he and [[unnamed Suit 027]] were sent in to retrieve it. {{source|The Sceptre Deception}}\n\n== Abilities ==\nLike most Suits, he was issued with the standard Organization [[Titans]].\n\n{{col-begin}}\n{{col-2}}\n=== Spells Utilized ===\n* [[Augerfrost]]\n* [[Thundercut]] {{source|Home Turf}}\n\n{{col-2}}\n=== Bonded Titans ===\n* [[Bonelasher]]\n* [[Enforcer]]\n\n{{col-end}}\n[[Category:Seekers]]\n[[Category:Organization members]]\n[[Category:Suits]]","categories":["Characters","Organization members","Seekers","Suits"],"links":[{"target_id":"huntik:page:8234","status":"resolved","target_title":"Vienna, Austria","label":"Vienna, Austria","target_url":"https://huntik.fandom.com/wiki/Vienna%2C_Austria","href":"#/categories?name=Vienna%2C%20Austria"},{"target_id":"huntik:page:8072","status":"resolved","target_title":"Prague, Czech Republic","label":"Prague, Czech Republic","target_url":"https://huntik.fandom.com/wiki/Prague%2C_Czech_Republic","href":"#/categories?name=Prague%2C%20Czech%20Republic"},{"target_id":"huntik:page:1990","status":"resolved","target_title":"The Organization","label":"The Organization","target_url":"https://huntik.fandom.com/wiki/The_Organization","href":"#/entry/huntik%3Apage%3A1990"},{"target_id":"huntik:page:2050","status":"resolved","target_title":"Suits","label":"Suits","target_url":"https://huntik.fandom.com/wiki/Suits","href":"#/entry/huntik%3Apage%3A2050"},{"target_id":"huntik:page:3228","status":"resolved","target_title":"Home Turf","label":"Home Turf","target_url":"https://huntik.fandom.com/wiki/Home_Turf","href":"#/entry/huntik%3Apage%3A3228"},{"target_id":"huntik:page:2050","status":"resolved","target_title":"Suit","label":"Suit","target_url":"https://huntik.fandom.com/wiki/Suit","href":"#/entry/huntik%3Apage%3A2050"},{"target_id":"huntik:page:1990","status":"resolved","target_title":"the Organization","label":"the Organization","target_url":"https://huntik.fandom.com/wiki/the_Organization","href":"#/entry/huntik%3Apage%3A1990"},{"target_id":"huntik:page:8234","status":"resolved","target_title":"Vienna, Austria","label":"Vienna, Austria","target_url":"https://huntik.fandom.com/wiki/Vienna%2C_Austria","href":"#/categories?name=Vienna%2C%20Austria"},{"target_id":"huntik:page:3241","status":"resolved","target_title":"Klaus","label":"Klaus","target_url":"https://huntik.fandom.com/wiki/Klaus","href":"#/entry/huntik%3Apage%3A3241"},{"target_id":"huntik:page:3241","status":"resolved","target_title":"Klaus","label":"Klaus","target_url":"https://huntik.fandom.com/wiki/Klaus","href":"#/entry/huntik%3Apage%3A3241"},{"target_id":"huntik:page:2090","status":"resolved","target_title":"Rassimov","label":"Rassimov","target_url":"https://huntik.fandom.com/wiki/Rassimov","href":"#/entry/huntik%3Apage%3A2090"},{"target_id":"huntik:page:2006","status":"resolved","target_title":"Dante Vale","label":"Dante Vale","target_url":"https://huntik.fandom.com/wiki/Dante_Vale","href":"#/entry/huntik%3Apage%3A2006"},{"target_id