_Lambert","status":"resolved","href":"#/entry/huntik%3Apage%3A1983"},{"target_title":"Sophie Casterwill","label":"Sophie Casterwill","target_id":"huntik:page:2041","target_url":"https://huntik.fandom.com/wiki/Sophie_Casterwill","status":"resolved","href":"#/entry/huntik%3Apage%3A2041"},{"target_title":"Lok's dormitory","label":"Lok's dormitory","target_id":"huntik:page:2661","target_url":"https://huntik.fandom.com/wiki/Lok%27s_dormitory","status":"resolved","href":"#/entry/huntik%3Apage%3A2661"},{"target_title":"Dante Vale","label":"Dante Vale","target_id":"huntik:page:2006","target_url":"https://huntik.fandom.com/wiki/Dante_Vale","status":"resolved","href":"#/entry/huntik%3Apage%3A2006"},{"target_title":"Grier","label":"Grier","target_id":"huntik:page:2046","target_url":"https://huntik.fandom.com/wiki/Grier","status":"resolved","href":"#/entry/huntik%3Apage%3A2046"},{"target_title":"DeFoe","label":"DeFoe","target_id":"huntik:page:2048","target_url":"https://huntik.fandom.com/wiki/DeFoe","status":"resolved","href":"#/entry/huntik%3Apage%3A2048"},{"target_title":"Santiago","label":"Santiago","target_id":"huntik:page:2055","target_url":"https://huntik.fandom.com/wiki/Santiago","status":"resolved","href":"#/entry/huntik%3Apage%3A2055"},{"target_title":"Road of Alchemists","label":"Road of Alchemists","target_id":"huntik:page:2736","target_url":"https://huntik.fandom.com/wiki/Road_of_Alchemists","status":"resolved","href":"#/entry/huntik%3Apage%3A2736"},{"target_title":"Lok Lambert","label":"Lok Lambert","target_id":"huntik:page:1983","target_url":"https://huntik.fandom.com/wiki/Lok_Lambert","status":"resolved","href":"#/entry/huntik%3Apage%3A1983"},{"target_title":"Overslam","label":"Overslam","target_id":"huntik:page:7237","target_url":"https://huntik.fandom.com/wiki/Overslam","status":"resolved","href":"#/entry/huntik%3Apage%3A7237"},{"target_title":"Titans","label":"Titans","target_id":"huntik:page:2010","target_url":"https://huntik.fandom.com/wiki/Titans","status":