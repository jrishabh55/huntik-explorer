ntik.fandom.com/wiki/Nordrake","status":"resolved","href":"#/entry/huntik%3Apage%3A3297"},{"target_title":"The Professor","label":"The Professor","target_id":"huntik:page:2053","target_url":"https://huntik.fandom.com/wiki/The_Professor","status":"resolved","href":"#/entry/huntik%3Apage%3A2053"}]},{"name":"rarity","value_wikitext":"Common","value_text":"Common","links":[]},{"name":"set id","value_wikitext":"[[LGS]]-022","value_text":"LGS-022","links":[{"target_title":"LGS","label":"LGS","target_id":"huntik:page:6036","target_url":"https://huntik.fandom.com/wiki/LGS","status":"resolved","href":"#/entry/huntik%3Apage%3A6036"}]},{"name":"power","value_wikitext":"'''[[TCG:Unblockable|Unblockable]]'''\n'''Ice Blast'''-Exhaust Action: KO a stunned hero in either my zone or [[The Professor|The Professor's]] zone.","value_text":"Unblockable\nIce Blast-Exhaust Action: KO a stunned hero in either my zone or The Professor's zone.","links":[{"target_title":"TCG:Unblockable","label":"Unblockable","target_id":"huntik:page:2479","target_url":"https://huntik.fandom.com/wiki/TCG:Unblockable","status":"resolved","href":"#/entry/huntik%3Apage%3A2479"},{"target_title":"The Professor","label":"The Professor's","target_id":"huntik:page:2053","target_url":"https://huntik.fandom.com/wiki/The_Professor","status":"resolved","href":"#/entry/huntik%3Apage%3A2053"}]}],"start":0,"end":538}],"sections":[{"heading":"Trivia","level":2,"wikitext":"* LGS0-22 incorrectly classifies [[Nordrake]] as a [[Draco-Titan]], while Nordrake is officially a [[Litho-Titan]].\n* This card's version, The Professor's Icy Titan, is very similar to [[TCG:SAS-038|Jokoul: Icy Titan]].","text":"* LGS0-22 incorrectly classifies Nordrake as a Draco-Titan, while Nordrake is officially a Litho-Titan.\n* This card's version, The Professor's Icy Titan, is very similar to Jokoul: Icy Titan."},{"heading":"Playing Strategies","level":2,"wikitext":"This card is great in combination with [[TCG:SAS-045|The Professor: Leader of the Organization]] as that card can not only stun titans when he starts a combat, it also count as a [[The Professor/TCG|Professor card]] so Nordrake can finish the stunned enemy hero.\n\n[[Category:Common cards]]\n[[Category:Hero cards]]\n[[Category:Major Hero cards]]\n[[Category:Titan cards]]\n[[Category:Draco-Titan Cards]]\n[[Category:Evil cards]]\n[[Category:Legendary Saga]]","text":"This card is great in combination with The Professor: Leader of the Organization as that card can not only stun titans when he starts a combat, it also count as a Professor card so Nordrake can finish the stunned enemy hero."}],"full_text":"== Trivia ==\n* LGS0-22 incorrectly classifies Nordrake as a Draco-Titan, while Nordrake is officially a Litho-Titan.\n* This card's version, The Professor's Icy Titan, is very similar to Jokoul: Icy Titan.\n\n== Playing Strategies ==\nThis card is great in combination with The Professor: Leader of the Organization as that card can not only stun titans when he starts a combat, it also count as a Professor card so Nordrake can finish the stunned enemy hero.","raw_wikitext":"{{infobox hero card\n| image       = File: LGS 022 Nordrake.png\n| card name   = Nordrake\n| version     = The Professor's Icy Titan\n| deck        = Evil\n| attack      = 4\n| defense     = 4\n| hero type   = Major Hero\n| type        = [[Draco-Titan]]\n| flavor text = \"Finish [[Lok|him]] off, [[Nordrake]]!\"-[[The Professor]]\n| rarity      = Common\n| set id      = [[LGS]]-022\n| power       = '''[[TCG:Unblockable|Unblockable]]'''\n'''Ice Blast'''-Exhaust Action: KO a stunned hero in either my zone or [[The Professor|The Professor's]] zone.\n}}\n== Trivia ==\n* LGS0-22 incorrectly classifies [[Nordrake]] as a [[Draco-Titan]], while Nordrake is officially a [[Litho-Titan]].\n* This card's version, The Professor's Icy Titan, is very similar to [[TCG:SAS-038|Jokoul: Icy Titan]].\n\n== Playing Strategies ==\nThis card is great in combination with [[TCG:SAS-045|The Professor: Leader of the Organization]] as that card can not only stun titans when he starts a combat, it also count as a [[The Professor/TCG|Professor card]] so Nordrake can finish the stunned enemy hero.\n\n[[Category:Common cards]]\n[[Category:Hero cards]]\n[[Category:Major Hero cards]]\n[[Category:Titan cards]]\n[[Category:Draco-Titan Cards]]\n[[Category:Evil cards]]\n[[Category:Legendary Saga]]","categories":["Common cards","Draco-Titan Cards","Evil cards","Hero cards","Legendary Saga","Major Hero cards","Titan cards"],"links":[{"target_title":"Draco-Titan","label":"Draco-Titan","target_id":"huntik:page:2831","target_url":"https://huntik.fandom.com/wiki/Draco-Titan","status":"resolved","href":"#/categories?name=Draco-Titans"},{"target_title":"Lok","label":"him","target_id":"huntik:page:1983","target_url":"https://huntik.fandom.com/wiki/Lok","status":"resolved","href":"#/entry/huntik%3Apage%3A1983"},{"target_title":"Nordrake","label":"Nordrake","target_id":"huntik:page:3297","target_url":"https://huntik.fandom.com/wiki/Nordrake","status":"resolved","href":"#/entry/huntik%3Apage%3A3297"},{"target_title":"The Professor","label":"The Professor","target_id":"huntik:page:2053","target_url":"https://huntik.fandom.com/wiki/The_Professor","status":"resolved","href":"#/entry/huntik%3Apage%3A2053"},{"target_title":"LGS","label":"LGS","target_id":"huntik:page:6036","target_url":"https://huntik.fandom.com/wiki/LGS","status":"resolved","href":"#/entry/huntik%3Apage%3A6036"},{"target_title":"TCG:Unblockable","label":"Unblockable","target_id":"huntik:page:2479","target_url":"https://huntik.fandom.com/wiki/TCG:Unblockable","status":"resolved","href":"#/entry/huntik%3Apage%3A2479"},{"target_title":"The Professor","label":"The Professor's","target_id":"huntik:page:2053","target_url":"https://huntik.fandom.com/wiki/The_Professor","status":"resolved","href":"#/entry/huntik%3Apage%3A2053"},{"target_title":"Nordrake","label":"Nordrake","target_id":"huntik:page:3297","target_url":"https://huntik.fandom.