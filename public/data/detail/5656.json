imov's Secret","label":"Rassimov's Secret","target_id":"huntik:page:10633","target_url":"https://huntik.fandom.com/wiki/Rassimov%27s_Secret","status":"resolved","href":"#/entry/huntik%3Apage%3A10633"}]}},"infoboxes":[{"name":"infobox item","parameters":[{"name":"image","value_wikitext":"File:S2E47_Key_of_Nefertiti.png","value_text":"File:S2E47_Key_of_Nefertiti.png","links":[]},{"name":"type","value_wikitext":"Key","value_text":"Key","links":[]},{"name":"class","value_wikitext":"Item","value_text":"Item","links":[]},{"name":"effects","value_wikitext":"Opens the secret entrance to the [[Tomb of Tutankhamun]]","value_text":"Opens the secret entrance to the Tomb of Tutankhamun","links":[{"target_title":"Tomb of Tutankhamun","label":"Tomb of Tutankhamun","target_id":"huntik:page:4943","target_url":"https://huntik.fandom.com/wiki/Tomb_of_Tutankhamun","status":"resolved","href":"#/entry/huntik%3Apage%3A4943"}]},{"name":"source","value_wikitext":"[[Tomb of Nefertiti]]","value_text":"Tomb of Nefertiti","links":[{"target_title":"Tomb of Nefertiti","label":"Tomb of Nefertiti","target_id":"huntik:page:4942","target_url":"https://huntik.fandom.com/wiki/Tomb_of_Nefertiti","status":"resolved","href":"#/entry/huntik%3Apage%3A4942"}]},{"name":"users","value_wikitext":"[[Dante Vale]] <br> [[Nefertiti]] <br> [[Rassimov]]","value_text":"Dante Vale\nNefertiti\nRassimov","links":[{"target_title":"Dante Vale","label":"Dante Vale","target_id":"huntik:page:2006","target_url":"https://huntik.fandom.com/wiki/Dante_Vale","status":"resolved","href":"#/entry/huntik%3Apage%3A2006"},{"target_title":"Nefertiti","label":"Nefertiti","target_id":"huntik:page:19537","target_url":"https://huntik.fandom.com/wiki/Nefertiti","status":"resolved","href":"#/entry/huntik%3Apage%3A19537"},{"target_title":"Rassimov","label":"Rassimov","target_id":"huntik:page:2090","target_url":"https://huntik.fandom.com/wiki/Rassimov","status":"resolved","href":"#/entry/huntik%3Apage%3A2090"}]},{"name":"first","value_wikitext":"[[Rassimov's Secret]]","value_text":"Rassimov's Secret","links":[{"target_title":"Rassimov's Secret","label":"Rassimov's Secret","target_id":"huntik:page:10633","target_url":"https://huntik.fandom.com/wiki/Rassimov%27s_Secret","status":"resolved","href":"#/entry/huntik%3Apage%3A10633"}]}],"start":0,"end":316}],"sections":[{"heading":"History","level":2,"wikitext":"[[Rassimov]] and [[Harrison Fears]] traveled to the [[Tomb of Nefertiti]] to recover the Key. They then traveled to the [[Tomb of Tutankhamun]] where they attempted to open the secret entrance but were interrupted by the Huntik team. [[Dante Vale]] used [[Raypulse]] to cause Rassimov to drop the key and it quickly picked up by [[Cherit]]. Following the encounter, the team used the key to enter the tomb and recover the [[Necklace of Tutankhamun]]. {{source|Rassimov's Secret}}\n[[Category:Artifacts]]","text":"Rassimov and Harrison Fears traveled to the Tomb of Nefertiti to recover the Key. They then traveled to the Tomb of Tutankhamun where they attempted to open the secret entrance but were interrupted by the Huntik team. Dante Vale used Raypulse to cause Rassimov to drop the key and it quickly picked up by Cherit. Following the encounter, the team used the key to enter the tomb and recover the Necklace of Tutankhamun. [Rassimov's Secret]"}],"full_text":"The is a key located in the Tomb of Nefertiti the key is hidden behind a door with the icon of the Blood Spiral. The key can open the secret entrance of the Tomb of Tutankhamun.\n\nHistory\n\nRassimov and Harrison Fears traveled to the Tomb of Nefertiti to recover the Key. They then traveled to the Tomb of Tutankhamun where they attempted to open the secret entrance but were interrupted by the Huntik team. Dante Vale used Raypulse to cause Rassimov to drop the key and it quickly picked up by Cherit. Following the encounter, the team used the key to enter the tomb and recover the Necklace of Tutankhamun. [Rassimov's Secret]","raw_wikitext":"{{infobox item\n| image      = File:S2E47_Key_of_Nefertiti.png\n| type       = Key\n| class      = Item\n| effects    = Opens the secret entrance to the [[Tomb of Tutankhamun]]\n| source     = [[Tomb of Nefertiti]]\n| users      = [[Dante Vale]] <br> [[Nefertiti]] <br> [[Rassimov]]\n| first      = [[Rassimov's Secret]]\n}}\nThe '''{{BASEPAGENAME}}''' is a key located in the [[Tomb of Nefertiti]] the key is hidden behind a door with the icon of the [[Blood Spiral]]. The key can open the secret entrance of the [[Tomb of Tutankhamun]].\n\n== History ==\n[[Rassimov]] and [[Harrison Fears]] traveled to the [[Tomb of Nefertiti]] to recover the Key. They then traveled to the [[Tomb of Tutankhamun]] where they attempted to open the secret entrance but were interrupted by the Huntik team. [[Dante Vale]] used [[Raypulse]] to cause Rassimov to drop the key and it quickly picked up by [[Cherit]]. Following the encounter, the team used the key to enter the tomb and recover the [[Necklace of Tutankhamun]]. {{source|Rassimov's Secret}}\n[[Category:Artifacts]]","categories":["Artifacts"],"links":[{"target_id":"huntik:page:4943","status":"resolved","target_title":"Tomb of Tutankhamun","label":"Tomb of Tutankhamun","target_url":"https://huntik.fandom.com/wiki/Tomb_of_Tutankhamun","href":"#/entry/huntik%3Apage%3A4943"},{"target_id":"huntik:page:4942","status":"resolved","target_title":"Tomb of Nefertiti","label":"Tomb of Nefertiti","target_url":"https://huntik.fandom.com/wiki/Tomb_of_Nefertiti","href":"#/entry/huntik%3Apage%3A4942"},{"target_id":"huntik:page:2006","status":"resolved","target_title":"Dante Vale","label":"Dante Vale","target_url":"https://huntik.fandom.com/wiki/Dante_Vale","href":"#/entry/huntik%3Apage%3A2006"},{"target_id":"huntik:page:19537","status":"resolved","target_title":"Nefertiti","label":"Nefertiti","target_url":"https://huntik.fandom.com/wiki/Nefertiti","href":"#/entry/huntik%3Apage%3A19537"},{"target_id":"huntik:page:2090","status":"resolved","target_title":"Rassimov","labe